// ══════════════════════════════════════════
//  INPUTS — COMPARATIF SL SERRÉ (NOUVEAU, expérimental)
//  Simule en parallèle un SL plus serré que le SL structurel, TP inchangé.
//  Deux variantes:
//    - "Mèche" = déclenché dès que le prix touche le niveau (comme un vrai
//      ordre stop broker — c'est ce qui se passerait réellement en trading).
//    - "Clôture" = déclenché seulement si la bougie CLÔTURE au-delà (ne
//      correspond PAS à un ordre stop classique — suppose une surveillance
//      manuelle en direct, pas exécutable tel quel avec un stop broker).
// ══════════════════════════════════════════
grp_slcompare = "🔬 Comparatif SL Serré (expérimental)"
showSlCompare = input.bool(false, title="Afficher comparatif SL serré?", group=grp_slcompare)

// ══════════════════════════════════════════
//  INPUTS — TOLÉRANCE RETOUR PIVOT (NOUVEAU)
//  Au lieu d'exiger un retour EXACT au niveau du pivot pour la ligne
//  "WR Swing (retour pivot)", on accepte un retour jusqu'à X% de la
//  distance du SL — proportionnel au risque de chaque trade, pas un
//  chiffre fixe en pips qui ne s'adapterait pas à la volatilité.
// ══════════════════════════════════════════
grp_retrace = "🔄 Tolérance Retour Pivot"
retraceTolerancePct = input.float(20.0, title="Marge de tolérance (% distance SL)", minval=0.0, maxval=100.0, step=5.0, group=grp_retrace,
                      tooltip="0% = retour exact au pivot (strict, comme avant). 20% = le prix compte comme 'retourné' dès qu'il revient à 20% de la distance du SL depuis le pivot. Plus le % est haut, plus il est facile de compter un trade comme 'retourné'.")
showRetraceLine = input.bool(true, title="Afficher la ligne du niveau de tolérance sur le graphique ?", group=grp_retrace)
retraceLineColor = input.color(color.new(#FF9800, 0), title="Couleur ligne tolérance", group=grp_retrace)
retraceLineBars = input.int(3, title="Longueur de la ligne (bougies)", minval=1, maxval=20, group=grp_retrace)

atrSlMulTight = input.float(0.5, title="SL serré = ATR ×", minval=0.05, maxval=2.0, step=0.05, group=grp_slcompare,
               tooltip="Distance réduite testée en parallèle. TP identique au signal original (donc R:R amélioré si le SL serré tient).")
slCompareTablePos = input.string("Milieu droite", title="Position", options=["Haut droite","Haut gauche","Bas droite","Bas gauche","Milieu droite"], group=grp_slcompare)
slCompareTableSize = input.string("Normal", title="Taille du tableau", options=["Compact","Normal","Grand","Très Grand"], group=grp_slcompare)

// ══════════════════════════════════════════
//  INPUTS — OPTIMISATION ENTRÉE RÉALISTE (NOUVEAU)
//  Deux tests indépendants pour chercher si l'entrée réaliste (prix de
//  confirmation) peut repasser au-dessus du seuil de rentabilité:
//  1) Confirmer plus tôt (délai réduit) — entrée plus proche du pivot.
//  2) RR cible plus faible — SL identique, TP plus proche.
// ══════════════════════════════════════════
grp_optim = "🔬 Optimisation Entrée Réaliste"
showOptimTable = input.bool(false, title="Afficher tableau optimisation ?", group=grp_optim)
earlyOffsetBars = input.int(3, title="Test — confirmer X bougies plus tôt", minval=1, maxval=15, group=grp_optim,
                  tooltip="Simule une entrée au prix de clôture d'il y a X bougies (approximation d'une confirmation plus rapide).")
altRR1 = input.float(1.5, title="Test — RR alternatif 1", minval=0.3, step=0.1, group=grp_optim)
altRR2 = input.float(2.0, title="Test — RR alternatif 2", minval=0.3, step=0.1, group=grp_optim)
optimTablePos = input.string("Bas gauche", title="Position", options=["Haut droite","Haut gauche","Bas droite","Bas gauche","Milieu droite"], group=grp_optim)
optimTableSize = input.string("Normal", title="Taille du tableau", options=["Compact","Normal","Grand","Très Grand"], group=grp_optim)

// ══════════════════════════════════════════
//  INPUTS — PRÉ-ALERTE (confirmation rapide, NOUVEAU)
//  Détecte un pivot H1 avec un délai de confirmation bien plus court que
//  le signal standard, MAIS exige obligatoirement que le validateur LTF
//  (Bougie -1/-2 + Vol/Body) soit GO pour compenser la détection plus
//  précoce et donc plus bruitée. Calculé dans la MÊME exécution que le
//  signal standard, sur les MÊMES bougies — comparaison propre, sans le
//  biais de fenêtre glissante qui affecte les tests via changement de
//  réglage + rechargement.
// ══════════════════════════════════════════
grp_prealert = "🚀 Pré-Alerte (confirmation rapide)"
showPreAlert = input.bool(false, title="Activer la pré-alerte ?", group=grp_prealert)
preAlertLbRight = input.int(4, title="Délai de confirmation (bougies, réduit)", minval=1, maxval=20, group=grp_prealert,
                  tooltip="Nettement plus petit que le lbRight standard — détecte plus tôt, mais nécessite le validateur LTF en GO pour filtrer le bruit.")
preAlertCooldownBars = input.int(5, title="Cooldown pré-alerte (bougies)", minval=0, group=grp_prealert)
preAlertTablePos = input.string("Milieu droite", title="Position tableau comparatif", options=["Haut droite","Haut gauche","Bas droite","Bas gauche","Milieu droite"], group=grp_prealert)
preAlertTableSize = input.string("Normal", title="Taille tableau", options=["Compact","Normal","Grand","Très Grand"], group=grp_prealert)


// Sweep & Swing — ATR V6 + VALIDATEUR ADAPTATIF (LTF auto)
//
// ══════════════════════════════════════════
// NOUVEAUTÉS V6 (vs V5):
// 1) Le validateur n'est plus fixé sur M15. Il s'adapte automatiquement
//    au timeframe du graphique:
//       Daily → validateur H4
//       H4    → validateur H1
//       H1    → validateur M15   (comme avant)
//       M30   → validateur M5
//    Mode manuel disponible si vous voulez forcer un TF précis.
// 2) Le VERDICT du validateur exige maintenant les 4 conditions
//    (N-1, N, Vol Boost, Body Clear) — plus de "GO" avec Vol/Body à NO.
// 3) Tableau du validateur: taille (Compact/Normal/Grand/Très Grand)
//    et position configurables.
// ══════════════════════════════════════════

//@version=6
indicator('Sweep & Swing — ATR V6 + VALIDATEUR ADAPTATIF', overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// ══════════════════════════════════════════
//  INPUTS — PIVOT AUTO PAR TF (signal principal, sur le TF du graphique)
// ══════════════════════════════════════════
grp0 = "⚙️ Pivot — Auto par Timeframe"
autoTf = input.bool(true, title="Pivot auto selon le TF actif?", group=grp0,
         tooltip="Si activé, lbLeft et lbRight sont ajustés automatiquement selon le TF du graphique.")

autoLbLeft  = timeframe.isdaily  ? 20 : timeframe.in_seconds() >= 14400 ? 20 : timeframe.in_seconds() >= 3600 ? 15 : timeframe.in_seconds() >= 1800 ? 10 : timeframe.in_seconds() >= 900 ? 8 : 5
autoLbRight = timeframe.isdaily  ? 15 : timeframe.in_seconds() >= 14400 ? 15 : timeframe.in_seconds() >= 3600 ? 10 : timeframe.in_seconds() >= 1800 ? 8  : timeframe.in_seconds() >= 900 ? 6 : 4
autoCooldown= timeframe.isdaily  ? 5  : timeframe.in_seconds() >= 14400 ? 5  : timeframe.in_seconds() >= 3600 ? 8  : timeframe.in_seconds() >= 1800 ? 10 : timeframe.in_seconds() >= 900 ? 12 : 15

manLbLeft   = input.int(20, title="Pivot Left Bars (manuel)",  minval=1, group=grp0)
manLbRight  = input.int(15, title="Pivot Right Bars (manuel)", minval=1, group=grp0)
manCooldown = input.int(5,  title="Cooldown (manuel)",         minval=0, group=grp0)

lbLeft  = autoTf ? autoLbLeft   : manLbLeft
lbRight = autoTf ? autoLbRight  : manLbRight
cooldownPeriod = autoTf ? autoCooldown : manCooldown


    expPA = resPA > 0 ? math.round(wrPA/100 * atrTpRR - (1 - wrPA/100), 2) : 0.0
    table.cell(preAlertTable, 0, 2, "Pré-Alerte (lbRight " + str.tostring(preAlertLbRight) + ")", text_color=ptClrWht, bgcolor=ptClrNeu, text_halign=text.align_left, text_size=pts)
    table.cell(preAlertTable, 1, 2, str.tostring(resPA), text_color=ptClrGry, bgcolor=ptClrNeu, text_halign=text.align_center, text_size=pts)
    table.cell(preAlertTable, 2, 2, resPA > 0 ? str.tostring(wrPA) + "%" : "—", text_color=ptClrWht, bgcolor=ptClrNeu, text_halign=text.align_center, text_size=pts)
    table.cell(preAlertTable, 3, 2, resPA > 0 ? str.tostring(expPA) : "—", text_color=expPA > 0 ? ptClrGrn : ptClrRed, bgcolor=ptClrNeu, text_halign=text.align_center, text_size=pts)


// ══════════════════════════════════════════
//  AIDE ENTRÉE TARDIVE — recalcul continu SL depuis le prix actuel,
//  TP fixe du dernier signal, R:R préservé.
// ══════════════════════════════════════════
liveEntryPx = close
atrNowForLate = mtfAtrUsed ? atrValMTF : atrVal
minSlDistFloor = atrNowForLate * lateEntryMinAtrFrac

hasRecentSignal = not na(lastSigTP)
remainingDist = hasRecentSignal ? (lastSigIsBull ? (lastSigTP - liveEntryPx) : (liveEntryPx - lastSigTP)) : na
neededSlDist = (hasRecentSignal and remainingDist > 0) ? remainingDist / lateEntryMinRR : na
liveSlPx = not na(neededSlDist) ? (lastSigIsBull ? liveEntryPx - neededSlDist : liveEntryPx + neededSlDist) : na

lateVerdictTxt = not hasRecentSignal ? "— Aucun signal récent" :
                 remainingDist <= 0 ? "❌ TP déjà atteint/dépassé" :
                 neededSlDist < minSlDistFloor ? "❌ Marge insuffisante (trop tardif)" :
                 "✅ Entrée tardive viable"
lateVerdictColor = not hasRecentSignal ? color.gray :
                 remainingDist <= 0 ? color.new(#b71c1c, 20) :
                 neededSlDist < minSlDistFloor ? color.new(#b71c1c, 20) :
                 color.new(#1b5e20, 20)

var table lateEntryTable = na

if showLateEntryHelper and barstate.islast
    lts = valTextSize(lateEntryTableSize)
    lateEntryTable := table.new(tablePosition(lateEntryTablePos), columns=2, rows=6,
                  bgcolor=color.new(#1a1a2e, 10),
                  border_color=color.new(#ffffff, 60), border_width=1,
                  frame_color=color.new(#ffffff, 40), frame_width=1)

    lClrHdr = color.new(#2d2d4e, 0)
    lClrWht = color.white
    lClrYel = color.new(#ffeb3b, 0)
    lClrGry = color.new(#aaaaaa, 0)
    lClrNeu = color.new(#1a237e, 30)

    table.cell(lateEntryTable, 0, 0, "⏰ ENTRÉE TARDIVE", text_color=lClrWht, bgcolor=lClrHdr, text_halign=text.align_left, text_size=lts)
    table.cell(lateEntryTable, 1, 0, lastSignalType, text_color=lClrYel, bgcolor=lClrHdr, text_halign=text.align_center, text_size=lts)

    table.cell(lateEntryTable, 0, 1, "Entrée actuelle (close)", text_color=lClrWht, bgcolor=lClrNeu, text_halign=text.align_left, text_size=lts)
    table.cell(lateEntryTable, 1, 1, priceStr(liveEntryPx), text_color=lClrWht, bgcolor=lClrNeu, text_halign=text.align_center, text_size=lts)

    table.cell(lateEntryTable, 0, 2, "TP visé (fixe)", text_color=lClrWht, bgcolor=lClrNeu, text_halign=text.align_left, text_size=lts)
    table.cell(lateEntryTable, 1, 2, hasRecentSignal ? priceStr(lastSigTP) : "—", text_color=lClrYel, bgcolor=lClrNeu, text_halign=text.align_center, text_size=lts)

    table.cell(lateEntryTable, 0, 3, "Distance restante", text_color=lClrWht, bgcolor=lClrNeu, text_halign=text.align_left, text_size=lts)
    table.cell(lateEntryTable, 1, 3, (hasRecentSignal and remainingDist > 0) ? priceStr(remainingDist) : "—", text_color=lClrGry, bgcolor=lClrNeu, text_halign=text.align_center, text_size=lts)

    table.cell(lateEntryTable, 0, 4, "SL suggéré (R:R " + str.tostring(lateEntryMinRR) + ")", text_color=lClrWht, bgcolor=lClrNeu, text_halign=text.align_left, text_size=lts)
    table.cell(lateEntryTable, 1, 4, not na(liveSlPx) ? priceStr(liveSlPx) : "—", text_color=lClrYel, bgcolor=lClrNeu, text_halign=text.align_center, text_size=lts)

    table.cell(lateEntryTable, 0, 5, "VERDICT", text_color=lClrWht, bgcolor=lClrHdr, text_halign=text.align_left, text_size=lts)
    table.cell(lateEntryTable, 1, 5, lateVerdictTxt, text_color=color.white, bgcolor=lateVerdictColor, text_halign=text.align_center, text_size=lts)



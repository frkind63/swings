lateEntryTablePos = input.string("Haut gauche", title="Position", options=["Haut droite","Haut gauche","Bas droite","Bas gauche","Milieu droite"], group=grp_late)
lateEntryTableSize = input.string("Normal", title="Taille du tableau", options=["Compact","Normal","Grand","Très Grand"], group=grp_late)

// ══════════════════════════════════════════
//  FONCTIONS UTILITAIRES
// ══════════════════════════════════════════
fLineStyle(s) =>
    s == 'Solid' ? line.style_solid : s == 'Dotted' ? line.style_dotted : line.style_dashed

priceStr(p) => str.tostring(math.round(p, 5))
pct(n, d)   => d == 0 ? "—" : str.tostring(math.round(n / d * 100, 1)) + "%"


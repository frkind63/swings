// Code numérique pour stockage dans tradeLog: 0=Hors session, 1=Londres, 2=New York, 3=Chevauchement
sessionCode = (inLondonSession and inNYSession) ? 3.0 : inLondonSession ? 1.0 : inNYSession ? 2.0 : 0.0
inAnySession = inLondonSession or inNYSession

// ══════════════════════════════════════════
//  RISQUE CUMULÉ DÉJÀ ENGAGÉ (pont avec Risk Manager)
// ══════════════════════════════════════════
currentRiskPctMM = mmMode == "Évaluation" ? riskPctEval : riskPctFunded
currentCumulCapMM = mmMode == "Évaluation" ? cumulRiskCapPctEval : cumulRiskCapPctFunded
projectedCumulRiskPct = manualOpenRiskPct + currentRiskPctMM
cumulRiskBreach = projectedCumulRiskPct > currentCumulCapMM
cumulRiskTxt = cumulRiskBreach ? " | ⚠️RISQUE CUMULÉ " + str.tostring(projectedCumulRiskPct, "#.##") + "%>" + str.tostring(currentCumulCapMM, "#.##") + "%" : ""

// ══════════════════════════════════════════
//  MONEY MANAGEMENT — Taille de pip / valeur de pip (approximatif)
//  ⚠️ Ces valeurs sont des standards de marché génériques (lot = 1.00,
//  soit 100 000 unités pour le forex). Elles NE reflètent PAS forcément
//  exactement les spécifications de contrat de TradeLocker ou de votre
//  broker MT5. Vérifiez toujours avant d'utiliser en argent réel.
// ══════════════════════════════════════════
f_pipSize(sym) =>
    str.contains(sym, "JPY") ? 0.01 : (str.contains(sym, "XAU") or str.contains(sym, "XAG")) ? 0.01 : 0.0001

f_pipValueUsdPerLot(sym) =>
    // Valeur approximative d'un pip pour 1.00 lot standard, en USD
    str.contains(sym, "JPY") ? 9.0 : str.contains(sym, "XAU") ? 10.0 : str.contains(sym, "XAG") ? 5.0 : 10.0

// Calcule un lot suggéré à partir de l'entrée/SL et du risque configuré.
// Retourne na si le calcul n'est pas fiable (distance SL nulle).
f_calcLot(entryPx, slPx, sym) =>
    riskPct = mmMode == "Évaluation" ? riskPctEval : riskPctFunded
    riskAmountAcctCcy = accountBalance * riskPct / 100
    riskAmountUSD = accountCurrency == "EUR" ? riskAmountAcctCcy * eurUsdManualRate : riskAmountAcctCcy
    pipSz = f_pipSize(sym)
    pipValUSD = f_pipValueUsdPerLot(sym)
    slDistPips = math.abs(entryPx - slPx) / pipSz
    rawLot = slDistPips > 0 ? riskAmountUSD / (slDistPips * pipValUSD) : na
    math.round(rawLot * 100) / 100

// Vérifie si le profit potentiel du TP dépasserait le plafond de consistency
// (40% du Reward Cap) en mode Financé — pour avertissement visuel uniquement.
f_tpExceedsCap(entryPx, tpPx, slPx, sym) =>
    lot = f_calcLot(entryPx, slPx, sym)
    pipSz = f_pipSize(sym)
    pipValUSD = f_pipValueUsdPerLot(sym)
    tpDistPips = math.abs(tpPx - entryPx) / pipSz
    potentialProfitUSD = tpDistPips * pipValUSD * lot
    capUSD = rewardCapFunded * 0.4
    mmMode == "Financé" and not na(lot) and potentialProfitUSD > capUSD

tablePosition(p) =>
    switch p
        "Haut droite"   => position.top_right
        "Haut gauche"   => position.top_left
        "Bas droite"    => position.bottom_right
        "Bas gauche"    => position.bottom_left
        "Milieu droite" => position.middle_right
        => position.bottom_right

valTextSize(s) =>
    switch s
        "Compact"     => size.tiny
        "Normal"      => size.small
        "Grand"       => size.normal
        "Très Grand"  => size.large
        => size.small

tfLabel() =>
    timeframe.isdaily ? "D1" : timeframe.in_seconds() >= 14400 ? "H4" : timeframe.in_seconds() >= 3600 ? "H1" : timeframe.in_seconds() >= 1800 ? "M30" : timeframe.in_seconds() >= 900 ? "M15" : "M5"

// Convertit un code TF request.security ("1","5","15","30","60","240","1440") en libellé lisible
tfLabelFor(tfStr) =>
    switch tfStr
        "1"    => "M1"
        "5"    => "M5"
        "15"   => "M15"
        "30"   => "M30"
        "60"   => "H1"
        "240"  => "H4"
        "1440" => "D1"
        => tfStr

// Détermine le TF du validateur (1 cran en dessous du chart) en mode auto
getAutoValidatorTf() =>
    if timeframe.isdaily
        "240"   // Daily → validateur H4
    else if timeframe.in_seconds() >= 14400
        "60"    // H4 → validateur H1
    else if timeframe.in_seconds() >= 3600
        "15"    // H1 → validateur M15
    else if timeframe.in_seconds() >= 1800
        "5"     // M30 → validateur M5
    else if timeframe.in_seconds() >= 900
        "5"     // M15 → validateur M5
    else
        "1"     // M5 ou moins → validateur M1

valTF = autoValidatorTf ? getAutoValidatorTf() : manValidatorTf

// Convertit un code TF en secondes pour calculer un lookback pivot adapté
valTfSeconds(tfStr) =>
    switch tfStr
        "1"    => 60
        "5"    => 300
        "15"   => 900
        "30"   => 1800
        "60"   => 3600
        "240"  => 14400
        "1440" => 86400
        => 900

// Lookback pivot adapté à N'IMPORTE QUEL TF (utilisé pour le validateur LTF)
f_lbForTF(tfSeconds) =>
    isD = tfSeconds >= 86400
    l = isD ? 20 : tfSeconds >= 14400 ? 20 : tfSeconds >= 3600 ? 15 : tfSeconds >= 1800 ? 10 : tfSeconds >= 900 ? 8 : 5
    r = isD ? 15 : tfSeconds >= 14400 ? 15 : tfSeconds >= 3600 ? 10 : tfSeconds >= 1800 ? 8  : tfSeconds >= 900 ? 6 : 4
    [l, r]

[valLbLeft, valLbRight] = f_lbForTF(valTfSeconds(valTF))

getMTFPeriod() =>
    if mtfSelector != "Auto"
        mtfSelector
    else
        if timeframe.isdaily
            "1440"
        else if timeframe.in_seconds() >= 14400
            "1440"
        else if timeframe.in_seconds() >= 3600
            "240"
        else if timeframe.in_seconds() >= 1800
            "60"
        else if timeframe.in_seconds() >= 900
            "60"
        else
            "60"

// Dessine un trade
drawTrade(entryPx, slPx, tpPx, isBull, sigBar, sigClr, lineArr, labelArr, boxArr) =>
    x1  = sigBar - extBars
    x2  = sigBar + extBars
    rrV = math.round(math.abs(tpPx - entryPx) / math.max(math.abs(entryPx - slPx), 0.00001), 1)
    rrTxt = showRRLbl ? " R:R 1:" + str.tostring(rrV) : ""

    array.push(lineArr, line.new(x1, entryPx, x2, entryPx, color=entryClr, width=2))
    array.push(lineArr, line.new(x1, slPx, x2, slPx, color=slClr, width=1, style=line.style_dashed))
    array.push(lineArr, line.new(x1, tpPx, x2, tpPx, color=tpClr, width=2, style=line.style_dashed))

    array.push(labelArr, label.new(x2, entryPx, text="E " + priceStr(entryPx),
               color=color.new(entryClr,15), textcolor=color.black, style=label.style_label_left, size=lblSize))
    array.push(labelArr, label.new(x2, slPx, text="SL " + priceStr(slPx),
               color=color.new(slClr,15), textcolor=color.white, style=label.style_label_left, size=lblSize))
    array.push(labelArr, label.new(x2, tpPx, text="TP " + priceStr(tpPx) + rrTxt,
               color=color.new(tpClr,15), textcolor=color.white, style=label.style_label_left, size=lblSize))

    if showRiskBox
        topBox = isBull ? entryPx : slPx
        botBox = isBull ? slPx : entryPx
        array.push(boxArr, box.new(x1, topBox, x2, botBox, border_color=color.new(sigClr, 50), bgcolor=color.new(sigClr, 88)))

// ══════════════════════════════════════════
//  DÉTECTION RSI DIVERGENCE
// ══════════════════════════════════════════
f_rsiDivergenceBull() =>
    rsi = ta.rsi(close, rsiDivLen)
    priceLow1 = ta.lowest(low, rsiDivLookback)
    priceLow2 = ta.lowest(low[rsiDivLookback], rsiDivLookback)
    rsiLow1 = ta.lowest(rsi, rsiDivLookback)
    rsiLow2 = ta.lowest(rsi[rsiDivLookback], rsiDivLookback)
    (priceLow1 > priceLow2) and (rsiLow1 < rsiLow2) and (rsi > rsiDivThresh)

f_rsiDivergenceBear() =>
    rsi = ta.rsi(close, rsiDivLen)
    priceHi1 = ta.highest(high, rsiDivLookback)
    priceHi2 = ta.highest(high[rsiDivLookback], rsiDivLookback)
    rsiHi1 = ta.highest(rsi, rsiDivLookback)
    rsiHi2 = ta.highest(rsi[rsiDivLookback], rsiDivLookback)
    (priceHi1 > priceHi2) and (rsiHi1 < rsiHi2) and (rsi < (100 - rsiDivThresh))

// ══════════════════════════════════════════
//  VALIDATION LTF ADAPTATIVE (Daily→H4, H4→H1, H1→M15, ...)
//  NOTE: Vol Boost et Body Clear décrivent la qualité de la bougie LTF
//  elle-même (volume, taille du corps). Ce ne sont PAS des critères
//  directionnels: ils sont donc identiques pour bull et bear, ce qui
//  est un comportement normal. Seuls le pivot utilisé (PivotLow vs
//  PivotHigh) et le sens des comparaisons de clôture diffèrent selon
//  la direction.
// ══════════════════════════════════════════
getEntryValidation(direction) =>
    // FIX ANTI-FLICKER: on ne travaille QUE sur des bougies LTF déjà
    // clôturées ([1] = dernière clôturée, [2] = avant-dernière).
    // Plus aucune valeur "en cours de formation" n'entre dans le calcul,
    // donc le verdict ne peut plus changer entre deux clôtures LTF —
    // il se met à jour une seule fois, proprement, à chaque clôture.
    valHigh = request.security(syminfo.tickerid, valTF, high[1])
    valLow = request.security(syminfo.tickerid, valTF, low[1])
    valClose = request.security(syminfo.tickerid, valTF, close[1])
    valOpen = request.security(syminfo.tickerid, valTF, open[1])
    valVolume = request.security(syminfo.tickerid, valTF, volume[1])
    valVolumeSMA = request.security(syminfo.tickerid, valTF, ta.sma(volume, 20)[1])
    
    // Pivot local LTF (lookback adapté au TF du validateur)
    valPivotHighVal = request.security(syminfo.tickerid, valTF, ta.valuewhen(not na(ta.pivothigh(high, valLbLeft, valLbRight)), high[valLbRight], 0))
    valPivotLowVal = request.security(syminfo.tickerid, valTF, ta.valuewhen(not na(ta.pivotlow(low, valLbLeft, valLbRight)), low[valLbRight], 0))
    // Heure de confirmation du dernier pivot LTF — sert à juger s'il est "frais"
    // (formé récemment, preuve indépendante) ou "vieux" (réutilisé depuis longtemps).
    valPivotHighTime = request.security(syminfo.tickerid, valTF, ta.valuewhen(not na(ta.pivothigh(high, valLbLeft, valLbRight)), time[valLbRight], 0))
    valPivotLowTime = request.security(syminfo.tickerid, valTF, ta.valuewhen(not na(ta.pivotlow(low, valLbLeft, valLbRight)), time[valLbRight], 0))
    
    // Bougie encore avant (avant-dernière clôturée)
    valClose1 = request.security(syminfo.tickerid, valTF, close[2])
    valOpen1 = request.security(syminfo.tickerid, valTF, open[2])
    
    // Calculs
    valBody = math.abs(valClose - valOpen)
    valRange = valHigh - valLow
    valBodyRatio = valRange > 0 ? valBody / valRange : 0
    
    valBody1 = math.abs(valClose1 - valOpen1)
    valRange1 = request.security(syminfo.tickerid, valTF, high[2] - low[2])
    valBodyRatio1 = valRange1 > 0 ? valBody1 / valRange1 : 0
    
    // Détection confirmations
    freshWindowMs = valTfSeconds(valTF) * 1000 * ltfFreshPivotBars
    if direction > 0  // BULL
        prev_above_pivot = valClose1 > valPivotLowVal
        curr_above_pivot = valClose > valPivotLowVal
        vol_boost = valVolume > valVolumeSMA * m15VolumeThreshold
        body_clear = valBodyRatio >= m15BodyThreshold and valBodyRatio1 >= m15BodyThreshold
        pivot_fresh = not na(valPivotLowTime) and (time - valPivotLowTime) <= freshWindowMs
        [prev_above_pivot, curr_above_pivot, vol_boost, body_clear, valPivotLowVal, valClose, valVolume, valVolumeSMA, pivot_fresh]
    else  // BEAR
        prev_below_pivot = valClose1 < valPivotHighVal
        curr_below_pivot = valClose < valPivotHighVal
        vol_boost = valVolume > valVolumeSMA * m15VolumeThreshold
        body_clear = valBodyRatio >= m15BodyThreshold and valBodyRatio1 >= m15BodyThreshold
        pivot_fresh = not na(valPivotHighTime) and (time - valPivotHighTime) <= freshWindowMs
        [prev_below_pivot, curr_below_pivot, vol_boost, body_clear, valPivotHighVal, valClose, valVolume, valVolumeSMA, pivot_fresh]

// ══════════════════════════════════════════
//  PIVOTS (TF principal du graphique)
// ══════════════════════════════════════════
pLow  = ta.pivotlow(low, lbLeft, lbRight)
pHigh = ta.pivothigh(high, lbLeft, lbRight)

pLowVal  = ta.valuewhen(not na(pLow), low[lbRight], 0)
pHighVal = ta.valuewhen(not na(pHigh), high[lbRight], 0)

prevLowIndex  = ta.valuewhen(not na(pLow), bar_index[lbRight], 0)
prevHighIndex = ta.valuewhen(not na(pHigh), bar_index[lbRight], 0)

lp = ta.lowest(low, lbLeft)
hp = ta.highest(high, lbLeft)
highestClose = ta.highest(close, lbLeft)
lowestClose = ta.lowest(close, lbLeft)

// ══════════════════════════════════════════
//  PIVOTS MTF
// ══════════════════════════════════════════
mtfPeriod = getMTFPeriod()

[mtf_pHigh, mtf_pLow] = request.security(syminfo.tickerid, mtfPeriod,
    [ta.pivothigh(high, lbLeft, lbRight), ta.pivotlow(low, lbLeft, lbRight)])

mtfBullConfirm = not useMTF or not na(mtf_pLow)
mtfBearConfirm = not useMTF or not na(mtf_pHigh)

// ══════════════════════════════════════════
//  ATR
// ══════════════════════════════════════════
atrVal = ta.atr(atrLen)
atrValMTF = mtfAtrUsed ? request.security(syminfo.tickerid, mtfPeriod, ta.atr(atrLen)) : atrVal

// ══════════════════════════════════════════
//  SWEEP CONDITIONS
// ══════════════════════════════════════════
bullishSFP = low < pLowVal and close > pLowVal and open > pLowVal and low == lp and lowestClose >= pLowVal
bearishSFP = high > pHighVal and close < pHighVal and open < pHighVal and high == hp and highestClose <= pHighVal

var int bullSweepIdx = 0
var int bearSweepIdx = 0

bullSweep = bullishSFP[sweepConfDelay] and close > pLowVal and close[1] > pLowVal[1] and close[2] > pLowVal[2] and bar_index >= bullSweepIdx + cooldownPeriod
bearSweep = bearishSFP[sweepConfDelay] and close < pHighVal and close[1] < pHighVal[1] and close[2] < pHighVal[2] and bar_index >= bearSweepIdx + cooldownPeriod

// ══════════════════════════════════════════
//  SWING CONDITIONS
// ══════════════════════════════════════════
var int swingBullIdx = 0
var int swingBearIdx = 0

newSwingLow = not na(pLow) and not bullishSFP[lbRight]
newSwingHigh = not na(pHigh) and not bearishSFP[lbRight]

swingBullCond = showSwingSignal and newSwingLow and bar_index >= swingBullIdx + cooldownPeriod
swingBearCond = showSwingSignal and newSwingHigh and bar_index >= swingBearIdx + cooldownPeriod

// ══════════════════════════════════════════
//  PIVOT RAPIDE (PRÉ-ALERTE) — même lbLeft (rigueur du côté gauche
//  inchangée), mais lbRight bien plus court → confirmation plus précoce.
//  Le bruit supplémentaire est censé être filtré par l'exigence du
//  validateur LTF en GO (appliquée plus bas dans preAlertBullFinal).
// ══════════════════════════════════════════
fastPLow  = ta.pivotlow(low, lbLeft, preAlertLbRight)
fastPHigh = ta.pivothigh(high, lbLeft, preAlertLbRight)
fastPLowVal  = ta.valuewhen(not na(fastPLow), low[preAlertLbRight], 0)
fastPHighVal = ta.valuewhen(not na(fastPHigh), high[preAlertLbRight], 0)

var int preAlertBullIdx = 0
var int preAlertBearIdx = 0

newFastSwingLow  = not na(fastPLow)
newFastSwingHigh = not na(fastPHigh)

// ══════════════════════════════════════════
//  FILTRES
// ══════════════════════════════════════════
ema21  = ta.ema(close, emaFast)
ema50  = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)

candleBody = math.abs(close - open)
candleRange = high - low
bodyOk = candleRange > 0 and (candleBody / candleRange) >= bodyRatio

emaOkBull = not useEma or ema21 > ema50
emaOkBear = not useEma or ema21 < ema50
rsiOkBull = not useRsi or rsiVal > rsiMid
rsiOkBear = not useRsi or rsiVal < rsiMid
bodyOkBull = not useBody or (bodyOk and close > open)
bodyOkBear = not useBody or (bodyOk and close < open)

bullConfirm = emaOkBull and rsiOkBull and bodyOkBull
bearConfirm = emaOkBear and rsiOkBear and bodyOkBear

rsiDivBull = useRsiDiv ? f_rsiDivergenceBull() : true
rsiDivBear = useRsiDiv ? f_rsiDivergenceBear() : true

// ══════════════════════════════════════════
//  VALIDATION LTF (Récupération)
// ══════════════════════════════════════════
[val_prev_confirm_bull, val_curr_confirm_bull, val_vol_bull, val_body_bull, val_pivot_bull, val_close_bull, val_vol_bull_val, val_vol_sma_bull, val_pivot_fresh_bull] = getEntryValidation(1.0)
[val_prev_confirm_bear, val_curr_confirm_bear, val_vol_bear, val_body_bear, val_pivot_bear, val_close_bear, val_vol_bear_val, val_vol_sma_bear, val_pivot_fresh_bear] = getEntryValidation(-1.0)

// Verdict = les 4 conditions (N-1, N, Vol Boost, Body Clear)
// Bougie -1/-2 toujours obligatoires. Vol Boost + Body Clear: ET (strict) ou OU (souple) selon le réglage.
volBodyBull = ltfValidationMode == "Strict (2/2)" ? (val_vol_bull and val_body_bull) : (val_vol_bull or val_body_bull)
volBodyBear = ltfValidationMode == "Strict (2/2)" ? (val_vol_bear and val_body_bear) : (val_vol_bear or val_body_bear)
val_valid_bull = val_prev_confirm_bull and val_curr_confirm_bull and volBodyBull
val_valid_bear = val_prev_confirm_bear and val_curr_confirm_bear and volBodyBear

// ══════════════════════════════════════════
//  SIGNAUX FINAUX
// ══════════════════════════════════════════
swingBullFinal = swingBullCond and (not useConfirm or bullConfirm) and mtfBullConfirm and rsiDivBull and (not useSessionFilter or inAnySession)
swingBearFinal = swingBearCond and (not useConfirm or bearConfirm) and mtfBearConfirm and rsiDivBear and (not useSessionFilter or inAnySession)
sweepBullFinal = showSweepSignal and bullSweep and (not useConfirm or bullConfirm) and mtfBullConfirm and rsiDivBull and (not useSessionFilter or inAnySession)
sweepBearFinal = showSweepSignal and bearSweep and (not useConfirm or bearConfirm) and mtfBearConfirm and rsiDivBear and (not useSessionFilter or inAnySession)

// Pré-alerte : confirmation plus rapide (preAlertLbRight), MAIS validateur
// LTF obligatoirement GO (val_valid_bull/bear) pour compenser le bruit
// supplémentaire d'une confirmation plus précoce.
preAlertBullFinal = showPreAlert and newFastSwingLow and val_valid_bull and (not useConfirm or bullConfirm) and mtfBullConfirm and rsiDivBull and (not useSessionFilter or inAnySession) and bar_index >= preAlertBullIdx + preAlertCooldownBars
preAlertBearFinal = showPreAlert and newFastSwingHigh and val_valid_bear and (not useConfirm or bearConfirm) and mtfBearConfirm and rsiDivBear and (not useSessionFilter or inAnySession) and bar_index >= preAlertBearIdx + preAlertCooldownBars

// ══════════════════════════════════════════
//  CALCUL ATR TP/SL
// ══════════════════════════════════════════
calcATR(entryPx, isBull, isMTFValidated, isRSIDivValidated) =>
    atrUsed = mtfAtrUsed ? atrValMTF : atrVal
    slMul = (isMTFValidated and isRSIDivValidated) ? atrSlMulReduced : atrSlMul
    slDist = atrUsed * slMul
    slPx   = isBull ? entryPx - slDist : entryPx + slDist
    tpPx   = isBull ? entryPx + slDist * atrTpRR : entryPx - slDist * atrTpRR
    [slPx, tpPx]

[sbSl, sbTp] = calcATR(pLowVal, true, mtfBullConfirm, rsiDivBull)
[scSl, scTp] = calcATR(pHighVal, false, mtfBearConfirm, rsiDivBear)
[swbSl, swbTp] = calcATR(pLowVal, true, mtfBullConfirm, rsiDivBull)
[swcSl, swcTp] = calcATR(pHighVal, false, mtfBearConfirm, rsiDivBear)

// SL serré (comparatif) — même ATR de référence, multiplicateur réduit, TP inchangé
f_tightSl(entryPx, isBull) =>
    atrUsed = mtfAtrUsed ? atrValMTF : atrVal
    tightDist = atrUsed * atrSlMulTight
    isBull ? entryPx - tightDist : entryPx + tightDist

sbSlTight  = f_tightSl(pLowVal, true)
scSlTight  = f_tightSl(pHighVal, false)
swbSlTight = f_tightSl(pLowVal, true)
swcSlTight = f_tightSl(pHighVal, false)

// ══════════════════════════════════════════
//  ENTRÉE RÉALISTE (comparatif) — le backtest standard utilise le prix du
//  PIVOT (pLowVal/pHighVal), qui n'est confirmé que lbRight bougies plus
//  tard — vous ne pouvez JAMAIS entrer à ce prix en réel. Cette variante
//  simule une entrée au prix de CLÔTURE de la bougie de confirmation
//  (celle que vous voyez réellement au moment de l'alerte), avec un
//  SL/TP recalculé depuis ce prix réel, même méthode ATR/RR que d'habitude.
// ══════════════════════════════════════════
f_realisticSlTp(entryPx, isBull, isMTFValidated, isRSIDivValidated) =>
    atrUsed = mtfAtrUsed ? atrValMTF : atrVal
    slMul = (isMTFValidated and isRSIDivValidated) ? atrSlMulReduced : atrSlMul
    slDist = atrUsed * slMul
    slPx   = isBull ? entryPx - slDist : entryPx + slDist
    tpPx   = isBull ? entryPx + slDist * atrTpRR : entryPx - slDist * atrTpRR
    [slPx, tpPx]

// ══════════════════════════════════════════
//  STATISTIQUES
// ══════════════════════════════════════════
var tradeLog = array.new_float(0)
var int statTotalSwing = 0
var int statTpSwing = 0
var int statSlSwing = 0
var int statTotalSweep = 0
var int statTpSweep = 0
var int statSlSweep = 0
var int statResolutionTimeSum = 0
var int statResolutionCount = 0

// Suivi winrate par heure (Europe/Paris) — 24 compteurs
var hourTotal = array.new_int(24, 0)
var hourWin = array.new_int(24, 0)

// Suivi winrate par session — 4 catégories: 0=Hors session, 1=Londres, 2=New York, 3=Chevauchement
var sessTotal = array.new_int(4, 0)
var sessWin = array.new_int(4, 0)

// Comparatif SL serré (mèche vs clôture)
var int statTpTight = 0
var int statSlTight = 0
var int statTpClose = 0
var int statSlClose = 0

// Comparatif Pivot LTF frais (filtre expérimental, informatif)
var int statTpFreshPivot = 0
var int statSlFreshPivot = 0

// Comparatif Entrée Réaliste (prix de confirmation, pas le pivot théorique)
var int statTpRealistic = 0
var int statSlRealistic = 0

// Optimisation Entrée Réaliste : confirmation anticipée + RR alternatifs
var int statTpEarly = 0
var int statSlEarly = 0
var int statTpRR1 = 0
var int statSlRR1 = 0
var int statTpRR2 = 0
var int statSlRR2 = 0

// Comparatif "retour vers le pivot avant TP" — swing uniquement
var int statTpRetrace = 0
var int statSlRetrace = 0

if swingBullFinal
    swingBullIdx := bar_index
    statTotalSwing += 1
    array.push(tradeLog, pLowVal)
    array.push(tradeLog, sbTp)
    array.push(tradeLog, sbSl)
    array.push(tradeLog, 1.0)
    array.push(tradeLog, float(bar_index))
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, float(hour(time, "Europe/Paris")))
    array.push(tradeLog, sessionCode)
    array.push(tradeLog, sbSlTight)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, val_pivot_fresh_bull ? 1.0 : 0.0)
    [realSlB1, realTpB1] = f_realisticSlTp(close, true, mtfBullConfirm, rsiDivBull)
    array.push(tradeLog, close)
    array.push(tradeLog, realSlB1)
    array.push(tradeLog, realTpB1)
    array.push(tradeLog, 0.0)
    entryEarlyB1 = close[earlyOffsetBars]
    [slEarlyB1, tpEarlyB1] = f_realisticSlTp(entryEarlyB1, true, mtfBullConfirm, rsiDivBull)
    array.push(tradeLog, entryEarlyB1)
    array.push(tradeLog, slEarlyB1)
    array.push(tradeLog, tpEarlyB1)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)

if swingBearFinal
    swingBearIdx := bar_index
    statTotalSwing += 1
    array.push(tradeLog, pHighVal)
    array.push(tradeLog, scTp)
    array.push(tradeLog, scSl)
    array.push(tradeLog, -1.0)
    array.push(tradeLog, float(bar_index))
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, float(hour(time, "Europe/Paris")))
    array.push(tradeLog, sessionCode)
    array.push(tradeLog, scSlTight)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, val_pivot_fresh_bear ? 1.0 : 0.0)
    [realSlB2, realTpB2] = f_realisticSlTp(close, false, mtfBearConfirm, rsiDivBear)
    array.push(tradeLog, close)
    array.push(tradeLog, realSlB2)
    array.push(tradeLog, realTpB2)
    array.push(tradeLog, 0.0)
    entryEarlyB2 = close[earlyOffsetBars]
    [slEarlyB2, tpEarlyB2] = f_realisticSlTp(entryEarlyB2, false, mtfBearConfirm, rsiDivBear)
    array.push(tradeLog, entryEarlyB2)
    array.push(tradeLog, slEarlyB2)
    array.push(tradeLog, tpEarlyB2)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)

if sweepBullFinal
    bullSweepIdx := bar_index
    statTotalSweep += 1
    array.push(tradeLog, pLowVal)
    array.push(tradeLog, swbTp)
    array.push(tradeLog, swbSl)
    array.push(tradeLog, 1.0)
    array.push(tradeLog, float(bar_index - sweepConfDelay))
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 1.0)
    array.push(tradeLog, float(hour(time, "Europe/Paris")))
    array.push(tradeLog, sessionCode)
    array.push(tradeLog, swbSlTight)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, val_pivot_fresh_bull ? 1.0 : 0.0)
    [realSlB3, realTpB3] = f_realisticSlTp(close, true, mtfBullConfirm, rsiDivBull)
    array.push(tradeLog, close)
    array.push(tradeLog, realSlB3)
    array.push(tradeLog, realTpB3)
    array.push(tradeLog, 0.0)
    entryEarlyB3 = close[earlyOffsetBars]
    [slEarlyB3, tpEarlyB3] = f_realisticSlTp(entryEarlyB3, true, mtfBullConfirm, rsiDivBull)
    array.push(tradeLog, entryEarlyB3)
    array.push(tradeLog, slEarlyB3)
    array.push(tradeLog, tpEarlyB3)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)

if sweepBearFinal
    bearSweepIdx := bar_index
    statTotalSweep += 1
    array.push(tradeLog, pHighVal)
    array.push(tradeLog, swcTp)
    array.push(tradeLog, swcSl)
    array.push(tradeLog, -1.0)
    array.push(tradeLog, float(bar_index - sweepConfDelay))
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 1.0)
    array.push(tradeLog, float(hour(time, "Europe/Paris")))
    array.push(tradeLog, sessionCode)
    array.push(tradeLog, swcSlTight)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, val_pivot_fresh_bear ? 1.0 : 0.0)
    [realSlB4, realTpB4] = f_realisticSlTp(close, false, mtfBearConfirm, rsiDivBear)
    array.push(tradeLog, close)
    array.push(tradeLog, realSlB4)
    array.push(tradeLog, realTpB4)
    array.push(tradeLog, 0.0)
    entryEarlyB4 = close[earlyOffsetBars]
    [slEarlyB4, tpEarlyB4] = f_realisticSlTp(entryEarlyB4, false, mtfBearConfirm, rsiDivBear)
    array.push(tradeLog, entryEarlyB4)
    array.push(tradeLog, slEarlyB4)
    array.push(tradeLog, tpEarlyB4)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)
    array.push(tradeLog, 0.0)

int nTrades = array.size(tradeLog) / 24

// ══════════════════════════════════════════
//  PRÉ-ALERTE — tracking séparé, entrée réaliste directement (close),
//  calculé dans la MÊME exécution que le signal standard ci-dessus.
// ══════════════════════════════════════════
var preAlertLog = array.new_float(0)
var int statTpPreAlert = 0
var int statSlPreAlert = 0

if preAlertBullFinal
    preAlertBullIdx := bar_index
    [paSl1, paTp1] = f_realisticSlTp(close, true, mtfBullConfirm, rsiDivBull)
    array.push(preAlertLog, close)
    array.push(preAlertLog, paSl1)
    array.push(preAlertLog, paTp1)
    array.push(preAlertLog, 1.0)
    array.push(preAlertLog, float(bar_index))
    array.push(preAlertLog, 0.0)

if preAlertBearFinal
    preAlertBearIdx := bar_index
    [paSl2, paTp2] = f_realisticSlTp(close, false, mtfBearConfirm, rsiDivBear)
    array.push(preAlertLog, close)
    array.push(preAlertLog, paSl2)
    array.push(preAlertLog, paTp2)
    array.push(preAlertLog, -1.0)
    array.push(preAlertLog, float(bar_index))
    array.push(preAlertLog, 0.0)

int nPreAlert = array.size(preAlertLog) / 6
if nPreAlert > 0
    for j = 0 to nPreAlert - 1
        pbase = j * 6
        pEntry_i = array.get(preAlertLog, pbase)
        pSl_i = array.get(preAlertLog, pbase + 1)
        pTp_i = array.get(preAlertLog, pbase + 2)
        pDir_i = array.get(preAlertLog, pbase + 3)
        pSigBar_i = array.get(preAlertLog, pbase + 4)
        pResolved = array.get(preAlertLog, pbase + 5)
        if pResolved == 0.0
            pIsBull = pDir_i > 0
            pElapsed = bar_index - int(pSigBar_i)
            pTimeout = pElapsed >= lookForward
            pTpHit = (pIsBull and high >= pTp_i) or (not pIsBull and low <= pTp_i)
            pSlHit = (pIsBull and low <= pSl_i) or (not pIsBull and high >= pSl_i)
            if pSlHit
                array.set(preAlertLog, pbase + 5, 1.0)
                statSlPreAlert += 1
            else if pTpHit
                array.set(preAlertLog, pbase + 5, 1.0)
                statTpPreAlert += 1
            else if pTimeout
                array.set(preAlertLog, pbase + 5, 1.0)
                statSlPreAlert += 1
int statPendSwing = 0
int statPendSweep = 0

if nTrades > 0
    for i = 0 to nTrades - 1
        base = i * 24
        tp_i = array.get(tradeLog, base + 1)
        sl_i = array.get(tradeLog, base + 2)
        dir_i = array.get(tradeLog, base + 3)
        sigBar_i = array.get(tradeLog, base + 4)
        resolved = array.get(tradeLog, base + 5)
        isSweep_i = array.get(tradeLog, base + 6) == 1.0
        hour_i = int(array.get(tradeLog, base + 7))
        sess_i = int(array.get(tradeLog, base + 8))
        tightSl_i = array.get(tradeLog, base + 9)
        resolvedTight = array.get(tradeLog, base + 10)
        resolvedClose = array.get(tradeLog, base + 11)
        wasFreshPivot = array.get(tradeLog, base + 12) == 1.0
        realEntry_i = array.get(tradeLog, base + 13)
        realSl_i = array.get(tradeLog, base + 14)
        realTp_i = array.get(tradeLog, base + 15)
        resolvedReal = array.get(tradeLog, base + 16)
        entryEarly_i = array.get(tradeLog, base + 17)
        slEarly_i = array.get(tradeLog, base + 18)
        tpEarly_i = array.get(tradeLog, base + 19)
        resolvedEarly = array.get(tradeLog, base + 20)
        resolvedRR1 = array.get(tradeLog, base + 21)
        resolvedRR2 = array.get(tradeLog, base + 22)
        entry_i = array.get(tradeLog, base + 0)
        retraceState_i = array.get(tradeLog, base + 23)

        isBull_i = dir_i > 0
        barsElapsed = bar_index - int(sigBar_i)
        timeout = barsElapsed >= lookForward

        // Suivi "monte puis redescend vers le pivot" — état 0=pas encore monté,
        // 1=monté au-dessus du pivot, 2=monté PUIS redescendu vers le pivot
        // avec tolérance (le motif recherché). Mis à jour tant que non résolu.
        slDistForRetrace_i = math.abs(entry_i - sl_i)
        retraceTolDist = slDistForRetrace_i * retraceTolerancePct / 100
        retraceThreshold_i = isBull_i ? entry_i + retraceTolDist : entry_i - retraceTolDist
        if resolved == 0.0 and barsElapsed >= 1
            if retraceState_i == 0.0 and (isBull_i ? high > entry_i : low < entry_i)
                array.set(tradeLog, base + 23, 1.0)
                retraceState_i := 1.0
            else if retraceState_i == 1.0 and (isBull_i ? low <= retraceThreshold_i : high >= retraceThreshold_i)
                array.set(tradeLog, base + 23, 2.0)
                retraceState_i := 2.0

        if resolved == 0.0
            tpHit = (isBull_i and high >= tp_i) or (not isBull_i and low <= tp_i)
            slHit = (isBull_i and low <= sl_i) or (not isBull_i and high >= sl_i)

            // FIX: quand une même bougie touche à la fois TP et SL, on ne peut pas
            // savoir avec des données OHLC lequel a été touché en premier dans le temps.
            // On prend l'hypothèse PESSIMISTE (SL vérifié en premier) plutôt que
            // d'assumer systématiquement le meilleur cas — sinon le winrate affiché
            // est artificiellement gonflé, surtout sur les grandes bougies (H4/D1)
            // où TP et SL peuvent être touchés dans la même bougie.
            if slHit
                array.set(tradeLog, base + 5, 1.0)
                statResolutionTimeSum += barsElapsed
                statResolutionCount += 1
                if isSweep_i
                    statSlSweep += 1
                else
                    statSlSwing += 1
                array.set(hourTotal, hour_i, array.get(hourTotal, hour_i) + 1)
                array.set(sessTotal, sess_i, array.get(sessTotal, sess_i) + 1)
                if wasFreshPivot
                    statSlFreshPivot += 1
                if not isSweep_i
                    statSlRetrace += 1
            else if tpHit
                array.set(tradeLog, base + 5, 1.0)
                statResolutionTimeSum += barsElapsed
                statResolutionCount += 1
                if isSweep_i
                    statTpSweep += 1
                else
                    statTpSwing += 1
                array.set(hourTotal, hour_i, array.get(hourTotal, hour_i) + 1)
                array.set(hourWin, hour_i, array.get(hourWin, hour_i) + 1)
                array.set(sessTotal, sess_i, array.get(sessTotal, sess_i) + 1)
                array.set(sessWin, sess_i, array.get(sessWin, sess_i) + 1)
                if wasFreshPivot
                    statTpFreshPivot += 1
                if not isSweep_i and retraceState_i == 2.0
                    statTpRetrace += 1
            else if timeout
                array.set(tradeLog, base + 5, 1.0)
                statResolutionTimeSum += barsElapsed
                statResolutionCount += 1
                if isSweep_i
                    statSlSweep += 1
                else
                    statSlSwing += 1
                array.set(hourTotal, hour_i, array.get(hourTotal, hour_i) + 1)
                array.set(sessTotal, sess_i, array.get(sessTotal, sess_i) + 1)
                if wasFreshPivot
                    statSlFreshPivot += 1
                if not isSweep_i
                    statSlRetrace += 1
            else
                if isSweep_i
                    statPendSweep += 1
                else
                    statPendSwing += 1

        // Variante SL serré "Mèche" — se déclenche dès que le prix touche le
        // niveau (low/high), comme un vrai ordre stop broker. TP identique au signal original.
        if showSlCompare and resolvedTight == 0.0
            tpHitT = (isBull_i and high >= tp_i) or (not isBull_i and low <= tp_i)
            tightSlHit = (isBull_i and low <= tightSl_i) or (not isBull_i and high >= tightSl_i)
            if tightSlHit
                array.set(tradeLog, base + 10, 1.0)
                statSlTight += 1
            else if tpHitT
                array.set(tradeLog, base + 10, 1.0)
                statTpTight += 1
            else if timeout
                array.set(tradeLog, base + 10, 1.0)
                statSlTight += 1

        // Variante SL serré "Clôture" — se déclenche seulement si la bougie
        // CLÔTURE au-delà du niveau. Ne correspond PAS à un ordre stop classique,
        // suppose une surveillance manuelle en direct (non exécutable tel quel).
        if showSlCompare and resolvedClose == 0.0
            tpHitC = (isBull_i and high >= tp_i) or (not isBull_i and low <= tp_i)
            closeSlHit = (isBull_i and close <= tightSl_i) or (not isBull_i and close >= tightSl_i)
            if closeSlHit
                array.set(tradeLog, base + 11, 1.0)
                statSlClose += 1
            else if tpHitC
                array.set(tradeLog, base + 11, 1.0)
                statTpClose += 1
            else if timeout
                array.set(tradeLog, base + 11, 1.0)
                statSlClose += 1

        // Variante ENTRÉE RÉALISTE — simule un trade pris au prix de CONFIRMATION
        // (close de la bougie où l'alerte se déclenche réellement), pas au prix
        // théorique du pivot. C'est le chiffre le plus proche de ce que vous
        // pouvez réellement exécuter en trading manuel.
        if resolvedReal == 0.0
            isBullR = dir_i > 0
            tpHitR = (isBullR and high >= realTp_i) or (not isBullR and low <= realTp_i)
            slHitR = (isBullR and low <= realSl_i) or (not isBullR and high >= realSl_i)
            if slHitR
                array.set(tradeLog, base + 16, 1.0)
                statSlRealistic += 1
            else if tpHitR
                array.set(tradeLog, base + 16, 1.0)
                statTpRealistic += 1
            else if timeout
                array.set(tradeLog, base + 16, 1.0)
                statSlRealistic += 1

        // OPTIMISATION 1 — Entrée anticipée (confirmer X bougies plus tôt,
        // approximé par le prix de clôture d'il y a X bougies au moment du signal)
        if showOptimTable and resolvedEarly == 0.0
            isBullE = dir_i > 0
            tpHitE = (isBullE and high >= tpEarly_i) or (not isBullE and low <= tpEarly_i)
            slHitE = (isBullE and low <= slEarly_i) or (not isBullE and high >= slEarly_i)
            if slHitE
                array.set(tradeLog, base + 20, 1.0)
                statSlEarly += 1
            else if tpHitE
                array.set(tradeLog, base + 20, 1.0)
                statTpEarly += 1
            else if timeout
                array.set(tradeLog, base + 20, 1.0)
                statSlEarly += 1

        // OPTIMISATION 2 — RR alternatif 1, même entrée/SL réalistes, TP recalculé
        if showOptimTable and resolvedRR1 == 0.0
            isBullG1 = dir_i > 0
            slDistG1 = math.abs(realEntry_i - realSl_i)
            tpRR1_i = isBullG1 ? realEntry_i + slDistG1 * altRR1 : realEntry_i - slDistG1 * altRR1
            tpHitG1 = (isBullG1 and high >= tpRR1_i) or (not isBullG1 and low <= tpRR1_i)
            slHitG1 = (isBullG1 and low <= realSl_i) or (not isBullG1 and high >= realSl_i)
            if slHitG1
                array.set(tradeLog, base + 21, 1.0)
                statSlRR1 += 1
            else if tpHitG1
                array.set(tradeLog, base + 21, 1.0)
                statTpRR1 += 1
            else if timeout
                array.set(tradeLog, base + 21, 1.0)
                statSlRR1 += 1

        // OPTIMISATION 3 — RR alternatif 2, même principe
        if showOptimTable and resolvedRR2 == 0.0
            isBullG2 = dir_i > 0
            slDistG2 = math.abs(realEntry_i - realSl_i)
            tpRR2_i = isBullG2 ? realEntry_i + slDistG2 * altRR2 : realEntry_i - slDistG2 * altRR2
            tpHitG2 = (isBullG2 and high >= tpRR2_i) or (not isBullG2 and low <= tpRR2_i)
            slHitG2 = (isBullG2 and low <= realSl_i) or (not isBullG2 and high >= realSl_i)
            if slHitG2
                array.set(tradeLog, base + 22, 1.0)
                statSlRR2 += 1
            else if tpHitG2
                array.set(tradeLog, base + 22, 1.0)
                statTpRR2 += 1
            else if timeout
                array.set(tradeLog, base + 22, 1.0)
                statSlRR2 += 1

// ══════════════════════════════════════════
//  SWING MARKERS
// ══════════════════════════════════════════
var label swingHighLbl = na
var label swingHighLblTxt = na
var label swingLowLbl = na
var label swingLowLblTxt = na
var swingHighArr = array.new_label(0)
var swingHighTextArr = array.new_label(0)
var swingLowArr = array.new_label(0)
var swingLowTextArr = array.new_label(0)

if array.size(swingHighArr) >= 8
    label.delete(array.shift(swingHighArr))
    label.delete(array.shift(swingHighTextArr))
if array.size(swingLowArr) >= 8
    label.delete(array.shift(swingLowArr))
    label.delete(array.shift(swingLowTextArr))

if showSwingMarkers and not na(pHigh) and not bearishSFP[lbRight]
    swingHighLbl := label.new(bar_index[lbRight], high[lbRight], text="", yloc=yloc.abovebar, color=swingClr, textcolor=swingClr, style=label.style_triangledown, size=size.auto)
    swingHighLblTxt := label.new(bar_index[lbRight], high[lbRight], text="H", yloc=yloc.abovebar, color=swingClr, textcolor=swingClr, style=label.style_none, size=size.tiny)
    array.push(swingHighArr, swingHighLbl)
    array.push(swingHighTextArr, swingHighLblTxt)

if showSwingMarkers and not na(pLow) and not bullishSFP[lbRight]
    swingLowLbl := label.new(bar_index[lbRight], low[lbRight], text="", yloc=yloc.belowbar, color=swingClr, textcolor=swingClr, style=label.style_triangleup, size=size.auto)
    swingLowLblTxt := label.new(bar_index[lbRight], low[lbRight], text="L", yloc=yloc.belowbar, color=swingClr, textcolor=swingClr, style=label.style_none, size=size.tiny)
    array.push(swingLowArr, swingLowLbl)
    array.push(swingLowTextArr, swingLowLblTxt)

// ══════════════════════════════════════════
//  SWEEP LINES
// ══════════════════════════════════════════
if sweepBullFinal
    x1s = math.max(prevLowIndex - extBars, 0)
    line.new(x1s, pLowVal, bar_index - sweepConfDelay, pLowVal, color=sweepBullColor, width=sweepLineWidth, style=fLineStyle(sweepLineStyle))
if sweepBearFinal
    x1s = math.max(prevHighIndex - extBars, 0)
    line.new(x1s, pHighVal, bar_index - sweepConfDelay, pHighVal, color=sweepBearColor, width=sweepLineWidth, style=fLineStyle(sweepLineStyle))

// ══════════════════════════════════════════
//  TRADES SUR GRAPHIQUE
// ══════════════════════════════════════════
var lineArr = array.new_line(0)
var labelArr = array.new_label(0)
var boxArr = array.new_box(0)

if array.size(lineArr) > maxTrades * 3
    for _i = 0 to 2
        line.delete(array.shift(lineArr))
if array.size(labelArr) > maxTrades * 4
    for _i = 0 to 3
        label.delete(array.shift(labelArr))
if array.size(boxArr) > maxTrades
    box.delete(array.shift(boxArr))

// ══════════════════════════════════════════
//  SIGNAUX + DESSIN + ALERTES
// ══════════════════════════════════════════

// Heure de CONFIRMATION du signal (Europe/Paris) — c'est le moment où le
// script reconnaît réellement le signal, pas l'heure du pivot/sweep visé
// en arrière sur le graphique. Utile pour savoir à quelle tranche horaire
// rattacher ce signal quand on le découvre en différé sur le chart.
signalHourNow = hour(time, "Europe/Paris")
signalHourTxt = " | Confirmé: " + str.tostring(signalHourNow) + "h"

var string lastSignalType = "—"
var int lastSignalHour = -1
var float lastSigTP = na
var float lastSigEntryOrig = na
var bool lastSigIsBull = false
if swingBullFinal or swingBearFinal or sweepBullFinal or sweepBearFinal
    lastSignalHour := signalHourNow
    lastSignalType := swingBullFinal ? "▲ SWING" : swingBearFinal ? "▼ SWING" : sweepBullFinal ? "⚡▲ SWEEP" : "⚡▼ SWEEP"
    lastSigTP := swingBullFinal ? sbTp : swingBearFinal ? scTp : sweepBullFinal ? swbTp : swcTp
    lastSigEntryOrig := (swingBullFinal or sweepBullFinal) ? pLowVal : pHighVal
    lastSigIsBull := swingBullFinal or sweepBullFinal

if swingBullFinal
    drawTrade(pLowVal, sbSl, sbTp, true, bar_index[lbRight], swingBullColor, lineArr, labelArr, boxArr)
    lotLbl1 = enableLotCalc ? " | Lot≈" + str.tostring(f_calcLot(pLowVal, sbSl, syminfo.ticker)) + (f_tpExceedsCap(pLowVal, sbTp, sbSl, syminfo.ticker) ? " ⚠️CAP" : "") : ""
    array.push(labelArr, label.new(bar_index[lbRight], pLowVal, text="▲ SWING L [" + timeframe.period + "]" + lotLbl1 + signalHourTxt + cumulRiskTxt,
               color=color.new(swingBullColor,10), textcolor=color.white, style=label.style_label_up, size=size.small))
    if showRetraceLine
        slDistDraw1 = math.abs(pLowVal - sbSl)
        retraceLevelDraw1 = pLowVal + slDistDraw1 * retraceTolerancePct / 100
        xStart1 = bar_index[lbRight]
